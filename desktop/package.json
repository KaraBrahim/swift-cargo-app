{
  "name": "swift-cargo-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Swift Cargo — poste de travail (Chine / Algérie)",
  "author": "Affari",
  "main": "main.js",
  "scripts": {
    "prepare-payload": "node prepare.mjs",
    "start": "node prepare.mjs && electron .",
    "dist": "node prepare.mjs && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.affari.swiftcargo",
    "productName": "Swift Cargo Desk",
    "directories": { "output": "release" },
    "files": ["main.js"],
    "extraResources": [
      { "from": "payload", "to": "payload" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
