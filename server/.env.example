# Copy to .env and adjust. If DATABASE_URL is empty, the server auto-starts a
# local embedded PostgreSQL (real Postgres, no install) and uses that.
PORT=4000
NODE_ENV=development

# Point this at your own / cloud Postgres to stop using the embedded one:
# DATABASE_URL=postgres://user:pass@host:5432/swiftcargo
DATABASE_URL="postgresql://neondb_owner:npg_dEh1IravlqK4@ep-purple-fire-ax3dgacg-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Embedded Postgres (used only when DATABASE_URL is empty):
USE_EMBEDDED_PG=1
EMBEDDED_PG_PORT=55432

# Auth
SESSION_TTL_HOURS=12

# OBLIGATOIRE. Le code ne contient aucun mot de passe par defaut : le serveur
# refuse de demarrer sans celui-ci. Le super-admin est le SEUL compte cree en
# production ; c'est lui qui cree ensuite les employes depuis Utilisateurs.
SUPERADMIN_PASSWORD=Super@2026

# Developpement uniquement. Mot de passe des comptes de demonstration
# admin1..admin4, qui ne sont crees que hors production. Laisser vide en
# production : ces comptes n'y existent pas.
SEED_ADMIN_PASSWORD=Swift@2026
